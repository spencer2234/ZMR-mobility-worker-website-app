<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and newer: what Google's automatic backup and phone-to-phone transfer may copy.
    Only the rent database is included. See docs/decisions.md ("Android automatic backup").
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
